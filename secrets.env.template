# LLM Provider API Keys für Zusammenfassungen
# Der LLM Client unterstützt Groq, OpenAI, Google Gemini, Ollama etc.
# Die Konfiguration erfolgt über llm_config.yaml.

# Groq API Key (Standard-Provider in llm_config.yaml): https://groq.com
GROQ_API_KEY=gsk_your_api_key_here

# OpenAI API Key (optional): https://platform.openai.com
OPENAI_API_KEY=sk-your_openai_key_here

# Gemini API Key (optional): https://ai.google.dev
GEMINI_API_KEY=your_gemini_key_here
